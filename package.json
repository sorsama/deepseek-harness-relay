{
  "name": "dsh-relay",
  "version": "0.1.0",
  "description": "Authenticated remote access for a DeepSeek Harness web profile: TLS, QR/passcode device pairing, password sign-in, and per-device revocation in front of an untouched loopback harness.",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "cordis",
    "relay",
    "remote",
    "mobile"
  ],
  "license": "MIT",
  "author": "sorsama",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sorsama/deepseek-harness-relay.git"
  },
  "homepage": "https://github.com/sorsama/deepseek-harness-relay#readme",
  "bugs": {
    "url": "https://github.com/sorsama/deepseek-harness-relay/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./startup": {
      "types": "./lib/types/startup.d.ts",
      "default": "./lib/startup.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**",
    "assets/**",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -b && tsdown",
    "prepare": "node scripts/prepare.mjs",
    "typecheck": "tsc -b --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src tests"
  },
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "packageManager": "pnpm@10.6.5",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "bonjour-service": "^1.3.0",
    "commander": "^15.0.0",
    "qrcode": "^1.5.4",
    "selfsigned": "^5.5.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.7"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-cmdline": "0.1.0-rc.7",
    "@deepseek-ai/dsh-host-webserver": "0.1.0-rc.7",
    "@deepseek-ai/schemastery": "3.18.1",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "oxlint": "^1.0.0",
    "tsdown": "^0.15.0",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  }
}
